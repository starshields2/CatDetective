    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: textComponentUI
      value: 
      objectReference: {fileID: 7582655181538369289, guid: 295f0e3a9cd838e45b1fec1df8f491a6, type: 3}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.size
      value: 16
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[0]
      value: You can't be here. Why are you here?
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[1]
      value: 'PETER! GET YOUR CAT! '
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[2]
      value: What the hell.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[3]
      value: Go on, get!
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[4]
      value: Peter, the cat is here.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[5]
      value: You ain't cute.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[6]
      value: Get away from me.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[7]
      value: You're not a detective, furball.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[8]
      value: Hey! Case closed, pal.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[9]
      value: Stop getting closer to me.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[10]
      value: Peter. Turn around.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[11]
      value: Excuse me?
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[12]
      value: Name and badge number?
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[13]
      value: '*grunt* ... *grumble* ...what?'
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[14]
      value: Did you clock in or something?
      objectReference: {fileID: 0}
    - target: {fileID: 8374845917811405175, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: lines.Array.data[15]
      value: I'm not feeding you.
      objectReference: {fileID: 0}
    - target: {fileID: 8374845918101549140, guid: 1ed7022975f65dc4aaabaf6461a03266, type: 3}
      propertyPath: m_SortingLayer
